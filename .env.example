# Demo works without any credentials or database. Live never falls back to demo.
APP_MODE=demo
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DB=dentalflow
ADMIN_EMAIL=
# Generate from stdin with npm run admin:hash. In .env.local, escape each $ as \$ (Next.js expands unescaped $).
# In Vercel settings, paste the hash literally without backslashes.
ADMIN_PASSWORD_HASH=
# Generate distinct random secrets, at least 32 characters each.
JWT_SECRET=
CRON_SECRET=
# Exactly 32 random bytes, base64 encoded. Keep a secure backup; existing tokens require this key.
TOKEN_ENCRYPTION_KEY=
VERCEL_PLAN=hobby
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/integrations/google/callback
GOOGLE_SHEETS_ID=
GOOGLE_CALENDAR_ID=primary
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
GEMINI_VOICE_BACKUP_MODEL=gemini-3.8-flash
CLINIC_TIMEZONE=Asia/Karachi
# Optional central fallback values. Clinic business settings in MongoDB (or legacy Sheets) retain their precedence.
CLINIC_NAME=Smile Dental Clinic
CLINIC_ADDRESS=12 Main Boulevard, Lahore
CLINIC_PHONE=+92 300 000 0000
CLINIC_CURRENCY=PKR
CLINIC_MAP_URL=https://maps.app.goo.gl/fWLCAxLLaZQMfbTU6
# Optional external scheduler, disabled until explicitly selected in the portal.
EXTERNAL_CRON_SECRET=
